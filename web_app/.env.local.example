# The API host. Requests go through this app's own origin at /api and are
# forwarded here, so the browser never talks to the API directly and CORS
# never applies. Defaults to the deployed server:
# API_ORIGIN=https://bernhackt26.kirchenfeldrobotics.ch

# Develop against a server on your own machine:
# API_ORIGIN=http://localhost:8000

# Bypass the forwarding and let the browser call the API directly. Only works
# if that server's ALLOWED_ORIGINS includes the address you are serving from.
# NEXT_PUBLIC_API_URL=http://localhost:8000
