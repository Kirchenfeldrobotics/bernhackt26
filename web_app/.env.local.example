# The API the browser calls, with no path of its own: the server's routes are
# /companies, /get-accepted-solutions and so on, mounted at its root.
# Defaults to the deployed server, https://bernhackt26.kirchenfeldrobotics.ch.

# Develop against a server on your own machine:
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Whatever this points at has to allow the origin this app is served from --
# ALLOWED_ORIGINS in the server's .env -- or the browser refuses the request
# before it is sent.
