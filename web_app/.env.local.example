# Requests go through this app's own origin at /backend and are forwarded to
# API_ORIGIN, so the browser never talks to the API directly and CORS never
# applies. Defaults to the backend on this machine:
# API_ORIGIN=http://127.0.0.1:8232

# Point at the public deployment instead:
# API_ORIGIN=https://bernhackt26.kirchenfeldrobotics.ch

# Develop against a server on your own machine:
# API_ORIGIN=http://localhost:8000

# Bypass the forwarding and let the browser call the API directly. Only works
# if that server's ALLOWED_ORIGINS includes the address you are serving from.
# NEXT_PUBLIC_API_URL=http://localhost:8000
