# Any OpenAI-compatible provider. Switching provider is these three lines and
# nothing else: OpenAI as-is, Google via OpenRouter, onprem.ai via its gateway.
LLM_API_KEY=

# Defaults to https://api.openai.com/v1 when unset or empty.
# LLM_BASE_URL=https://openrouter.ai/api/v1

# Defaults to gpt-4o when unset or empty.
# LLM_MODEL=gpt-4o

# Origins the web app is served from. Comma separated; "*" allows any.
# Defaults to localhost:3000 only, which is not enough once the web app is
# deployed somewhere else.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Where /receive-data writes each scan, and where the Gemini outputs are read
# back from. Defaults to /var/www/webapp-bernhackt/received.
# RECEIVE_DIR=

# Defaults to SQLite at server/data/app.db.
# DATABASE_URL=
